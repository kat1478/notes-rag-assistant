# Copy to backend/.env (git-ignored) and fill in what you need. Real environment variables win over this file.

# Model used when a request doesn't pick one: "<provider>:<model>"
DEFAULT_MODEL_ID=ollama:llama3.2:3b

# Local provider (default, no key needed)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Optional hosted provider — https://openrouter.ai/keys
# Tip: set a credit limit on the key in the OpenRouter dashboard.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Allowlist of selectable hosted models (comma-separated OpenRouter ids)
OPENROUTER_MODELS=meta-llama/llama-3.2-3b-instruct,qwen/qwen3-30b-a3b-instruct-2507,google/gemma-4-31b-it,anthropic/claude-haiku-5.5,anthropic/claude-sonnet-5.5,openai/gpt-5.6-sol

# Hidden reasoning for models that support it: off (default) | default
REASONING=off
